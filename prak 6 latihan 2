# Fungsi 1: Mengecek tahun kabisat
def tahun_kabisat(tahun):
    if tahun % 400 == 0 or (tahun % 4 == 0 and tahun % 100 != 0):
        return True
    else:
        return False


# Fungsi 2: Menghitung jumlah hari
def jumlah_hari(bulan, tahun):

    angka_bulan = {
        1: "januari", 2: "februari", 3: "maret",
        4: "april", 5: "mei", 6: "juni",
        7: "juli", 8: "agustus", 9: "september",
        10: "oktober", 11: "november", 12: "desember"
    }

    if bulan.isdigit():
        bulan = angka_bulan.get(int(bulan), "")

    if bulan == "februari":
        if tahun_kabisat(tahun):
            return 29
        else:
            return 28

    elif bulan in ["april", "juni", "september", "november"]:
        return 30

    elif bulan in ["januari", "maret", "mei", "juli", "agustus", "oktober", "desember"]:
        return 31

    else:
        return 0


# Program utama
bulan = input("Masukkan nama atau angka bulan: ").strip().lower()
tahun = int(input("Masukkan tahun: "))

# Mengecek tahun kabisat
if tahun_kabisat(tahun):
    print("Tahun", tahun, "adalah tahun kabisat.")
else:
    print("Tahun", tahun, "adalah tahun non-kabisat.")

# Menghitung jumlah hari
hasil = jumlah_hari(bulan, tahun)

if hasil == 0:
    print("Bulan tidak valid!")
else:
    print("Jumlah hari:", hasil)
